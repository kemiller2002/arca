<Project Sdk="Microsoft.NET.Sdk">
  <!-- A Limen engine that runs Arca's GitHub adapter in the browser
       (ARCA-TEST-003). Application authority only: no browser, network or
       interop code. Compiled reflection-free, as Limen's own engines are. -->
  <PropertyGroup>
    <OtherFlags>$(OtherFlags) --reflectionfree</OtherFlags>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Engine.fs" />
    <Compile Include="QueueEngine.fs" />
    <Compile Include="LimenQueueEngine.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Arca.Core/Arca.Core.fsproj" />
    <ProjectReference Include="../../../src/Arca.GitHub/Arca.GitHub.fsproj" />
    <ProjectReference Include="../../../src/Arca.Limen/Arca.Limen.fsproj" />
  </ItemGroup>
</Project>
