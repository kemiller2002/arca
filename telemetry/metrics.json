{
  "schemaVersion": "1.0.0",
  "description": "Provider-neutral normalized metrics understood by ROS. Provider fields not listed here remain in raw telemetry until promoted.",
  "metrics": [
    {"id":"tokens.input","category":"tokens","unit":"tokens","aggregation":"sum","collection":"runtime","description":"Input tokens consumed by model calls."},
    {"id":"tokens.output","category":"tokens","unit":"tokens","aggregation":"sum","collection":"runtime","description":"Output tokens emitted by model calls, including reasoning when the provider combines them."},
    {"id":"tokens.cached_input","category":"tokens","unit":"tokens","aggregation":"sum","collection":"runtime","description":"Input tokens served from a provider cache when exposed under a combined cache category."},
    {"id":"tokens.cached_output","category":"tokens","unit":"tokens","aggregation":"sum","collection":"runtime","description":"Output tokens served from a provider cache when separately exposed."},
    {"id":"tokens.cache_read","category":"tokens","unit":"tokens","aggregation":"sum","collection":"runtime","description":"Input tokens read from prompt cache."},
    {"id":"tokens.cache_write","category":"tokens","unit":"tokens","aggregation":"sum","collection":"runtime","description":"Input tokens written to prompt cache."},
    {"id":"tokens.reasoning","category":"tokens","unit":"tokens","aggregation":"sum","collection":"runtime","description":"Reasoning or thinking tokens when separately exposed."},
    {"id":"tokens.tool","category":"tokens","unit":"tokens","aggregation":"sum","collection":"runtime","description":"Tokens attributed to tool declarations or tool interactions when separately exposed."},
    {"id":"tokens.total","category":"tokens","unit":"tokens","aggregation":"sum","collection":"runtime","description":"Provider-reported per-operation total tokens; not calculated when category semantics are ambiguous."},
    {"id":"context.window_size","category":"context","unit":"tokens","aggregation":"none","collection":"runtime","description":"Model context-window size. Preserve per-session values; no scalar cross-session aggregate is valid."},
    {"id":"context.utilization","category":"context","unit":"ratio","aggregation":"none","collection":"runtime","description":"Fraction of the context window in use, from zero through one. Preserve per-session values."},
    {"id":"context.current_input_tokens","category":"context","unit":"tokens","aggregation":"none","collection":"runtime","description":"Input tokens currently occupying the context window; a session gauge, not an additive total."},
    {"id":"context.current_output_tokens","category":"context","unit":"tokens","aggregation":"none","collection":"runtime","description":"Output tokens in the runtime's current-context snapshot; a session gauge, not an additive total."},
    {"id":"context.current_cache_read_tokens","category":"context","unit":"tokens","aggregation":"none","collection":"runtime","description":"Cache-read tokens in the current-context snapshot; a session gauge, not an additive total."},
    {"id":"context.current_cache_write_tokens","category":"context","unit":"tokens","aggregation":"none","collection":"runtime","description":"Cache-write tokens in the current-context snapshot; a session gauge, not an additive total."},
    {"id":"context.repeated_file_reads","category":"context","unit":"count","aggregation":"sum","collection":"runtime","description":"File reads beyond the first read of the same file in one session: context re-acquired within the session."},
    {"id":"context.governance_reads","category":"context","unit":"count","aggregation":"sum","collection":"runtime","description":"Reads of startup and governance documents (AGENTS.md, CLAUDE.md, governance, work-protocol, planning, CLI and telemetry guides): per-session context overhead."},
    {"id":"context.compactions","category":"context","unit":"count","aggregation":"sum","collection":"runtime","description":"Context compression or compaction operations."},
    {"id":"session.tokens.cumulative","category":"tokens","unit":"tokens","aggregation":"latest-per-session","collection":"runtime","description":"Cumulative tokens for a provider session. Aggregation keeps one latest value per session."},
    {"id":"session.tokens.input_cumulative","category":"tokens","unit":"tokens","aggregation":"latest-per-session","collection":"runtime","description":"Cumulative input tokens for a provider session; suitable for explicit checkpoint deltas."},
    {"id":"session.tokens.output_cumulative","category":"tokens","unit":"tokens","aggregation":"latest-per-session","collection":"runtime","description":"Cumulative output tokens for a provider session; suitable for explicit checkpoint deltas."},
    {"id":"session.tokens.cached_input_cumulative","category":"tokens","unit":"tokens","aggregation":"latest-per-session","collection":"runtime","description":"Cumulative cached-input tokens for a provider session; suitable for explicit checkpoint deltas."},
    {"id":"session.tokens.cached_output_cumulative","category":"tokens","unit":"tokens","aggregation":"latest-per-session","collection":"runtime","description":"Cumulative cached-output tokens for a provider session; suitable for explicit checkpoint deltas."},
    {"id":"session.tokens.reasoning_cumulative","category":"tokens","unit":"tokens","aggregation":"latest-per-session","collection":"runtime","description":"Cumulative reasoning tokens for a provider session; suitable for explicit checkpoint deltas."},

    {"id":"cost.input","category":"cost","unit":"currency","aggregation":"sum","collection":"runtime-or-calculated","description":"Input-token cost."},
    {"id":"cost.output","category":"cost","unit":"currency","aggregation":"sum","collection":"runtime-or-calculated","description":"Output-token cost."},
    {"id":"cost.reasoning","category":"cost","unit":"currency","aggregation":"sum","collection":"runtime-or-calculated","description":"Reasoning-token cost when separately exposed."},
    {"id":"cost.cache","category":"cost","unit":"currency","aggregation":"sum","collection":"runtime-or-calculated","description":"Cache read/write cost."},
    {"id":"cost.tool_api","category":"cost","unit":"currency","aggregation":"sum","collection":"runtime","description":"Tool or external API cost."},
    {"id":"cost.execution_total","category":"cost","unit":"currency","aggregation":"sum","collection":"runtime-or-calculated","description":"Cost attributable to this execution."},
    {"id":"cost.step_total","category":"cost","unit":"currency","aggregation":"sum","collection":"runtime-or-calculated","description":"Cost explicitly attributable to one execution step."},
    {"id":"cost.session_cumulative","category":"cost","unit":"currency","aggregation":"latest-per-session","collection":"runtime","description":"Cumulative provider session cost. Aggregation keeps one latest value per session."},

    {"id":"time.wall_ms","category":"time","unit":"milliseconds","aggregation":"sum","collection":"ros-derived","description":"Per-execution wall-clock duration from ROS start through finalization; work-item sums may overlap and are not calendar elapsed time."},
    {"id":"time.active_ms","category":"time","unit":"milliseconds","aggregation":"sum","collection":"runtime","description":"Active execution time when the runtime distinguishes it."},
    {"id":"time.tool_ms","category":"time","unit":"milliseconds","aggregation":"sum","collection":"runtime","description":"Time spent executing tools."},
    {"id":"time.model_ms","category":"time","unit":"milliseconds","aggregation":"sum","collection":"runtime","description":"Time spent awaiting model processing."},
    {"id":"time.waiting_ms","category":"time","unit":"milliseconds","aggregation":"sum","collection":"runtime-or-calculated","description":"Known waiting time not otherwise classified."},
    {"id":"time.blocked_ms","category":"time","unit":"milliseconds","aggregation":"sum","collection":"ros-derived","description":"Time between ROS work block and resume/finalize events."},
    {"id":"time.human_interruption_ms","category":"time","unit":"milliseconds","aggregation":"sum","collection":"runtime","description":"Human-interruption time when distinguishable."},
    {"id":"time.retry_ms","category":"time","unit":"milliseconds","aggregation":"sum","collection":"runtime","description":"Time spent in retries."},
    {"id":"time.first_code_change_ms","category":"time","unit":"milliseconds","aggregation":"none","collection":"runtime","description":"Time from a session's first transcript entry to its first change under src/ or tests/: the session's cold-start cost. Preserve per-session values."},
    {"id":"time.first_token_ms","category":"time","unit":"milliseconds","aggregation":"sum","collection":"runtime","description":"Model time to first token."},

    {"id":"agent.turns","category":"agent-behavior","unit":"count","aggregation":"sum","collection":"runtime","description":"Agent or model turns."},
    {"id":"agent.reasoning_cycles","category":"agent-behavior","unit":"count","aggregation":"sum","collection":"runtime-or-agent","description":"Reasoning cycles when explicitly exposed or recorded."},
    {"id":"agent.retries","category":"agent-behavior","unit":"count","aggregation":"sum","collection":"runtime","description":"Agent or model retries."},
    {"id":"agent.self_corrections","category":"agent-behavior","unit":"count","aggregation":"sum","collection":"runtime-or-agent","description":"Explicit self-corrections."},
    {"id":"agent.failed_approaches","category":"agent-behavior","unit":"count","aggregation":"sum","collection":"agent","description":"Failed approaches explicitly recorded with evidence."},
    {"id":"agent.context_resets","category":"agent-behavior","unit":"count","aggregation":"sum","collection":"runtime","description":"Context clears or resets."},
    {"id":"agent.handoffs","category":"agent-behavior","unit":"count","aggregation":"sum","collection":"runtime-or-agent","description":"Execution handoffs."},
    {"id":"agent.subagents_spawned","category":"agent-behavior","unit":"count","aggregation":"sum","collection":"runtime","description":"Subagents spawned."},
    {"id":"agent.parallel_executions_peak","category":"agent-behavior","unit":"count","aggregation":"maximum","collection":"runtime-or-agent","description":"Peak known parallel agent executions."},
    {"id":"agent.interruptions","category":"agent-behavior","unit":"count","aggregation":"sum","collection":"runtime-or-ros","description":"Execution interruptions."},
    {"id":"agent.resumes","category":"agent-behavior","unit":"count","aggregation":"sum","collection":"runtime-or-ros","description":"Execution resumes."},
    {"id":"agent.human_escalations","category":"agent-behavior","unit":"count","aggregation":"sum","collection":"runtime-or-agent","description":"Escalations requiring human authority or input."},
    {"id":"agent.clarifications","category":"agent-behavior","unit":"count","aggregation":"sum","collection":"runtime-or-agent","description":"Agent-requested clarifications."},
    {"id":"agent.plan_revisions","category":"agent-behavior","unit":"count","aggregation":"sum","collection":"runtime-or-agent","description":"Material plan revisions."},
    {"id":"agent.scope_revisions","category":"agent-behavior","unit":"count","aggregation":"sum","collection":"runtime-or-agent","description":"Material scope revisions."},
    {"id":"agent.approvals_requested","category":"agent-behavior","unit":"count","aggregation":"sum","collection":"runtime","description":"Tool or action approvals requested."},
    {"id":"agent.approvals_denied","category":"agent-behavior","unit":"count","aggregation":"sum","collection":"runtime","description":"Tool or action approvals denied."},

    {"id":"model.requests","category":"model","unit":"count","aggregation":"sum","collection":"runtime","description":"Model API requests."},
    {"id":"model.request_failures","category":"model","unit":"count","aggregation":"sum","collection":"runtime","description":"Failed model API requests."},
    {"id":"tool.calls","category":"tools","unit":"count","aggregation":"sum","collection":"runtime","description":"Tool calls."},
    {"id":"tool.failures","category":"tools","unit":"count","aggregation":"sum","collection":"runtime","description":"Failed tool calls."},
    {"id":"tool.retries","category":"tools","unit":"count","aggregation":"sum","collection":"runtime","description":"Retried tool calls."},
    {"id":"tool.duration_ms","category":"tools","unit":"milliseconds","aggregation":"sum","collection":"runtime","description":"Tool-call duration."},
    {"id":"tool.cost","category":"tools","unit":"currency","aggregation":"sum","collection":"runtime","description":"Tool-call cost."},
    {"id":"tool.shell_commands","category":"tools","unit":"count","aggregation":"sum","collection":"runtime","description":"Shell command executions without command payloads."},
    {"id":"tool.file_reads","category":"tools","unit":"count","aggregation":"sum","collection":"runtime","description":"File read operations."},
    {"id":"tool.file_writes","category":"tools","unit":"count","aggregation":"sum","collection":"runtime","description":"File write operations."},
    {"id":"tool.searches","category":"tools","unit":"count","aggregation":"sum","collection":"runtime","description":"Repository or external search operations."},
    {"id":"tool.web_activity","category":"tools","unit":"count","aggregation":"sum","collection":"runtime","description":"Browser or web operations."},
    {"id":"tool.repository_operations","category":"tools","unit":"count","aggregation":"sum","collection":"runtime","description":"Version-control operations."},
    {"id":"tool.api_operations","category":"tools","unit":"count","aggregation":"sum","collection":"runtime","description":"API operations."},
    {"id":"tool.build_executions","category":"tools","unit":"count","aggregation":"sum","collection":"runtime","description":"Build tool executions."},
    {"id":"tool.test_executions","category":"tools","unit":"count","aggregation":"sum","collection":"runtime","description":"Test tool executions."},
    {"id":"tool.deployments","category":"tools","unit":"count","aggregation":"sum","collection":"runtime","description":"Deployment operations."},
    {"id":"tool.database_operations","category":"tools","unit":"count","aggregation":"sum","collection":"runtime","description":"Database operations."},
    {"id":"tool.external_service_calls","category":"tools","unit":"count","aggregation":"sum","collection":"runtime","description":"External-service calls."},

    {"id":"git.baseline_dirty_files","category":"repository","unit":"count","aggregation":"maximum","collection":"ros-derived","description":"Maximum dirty-path count observed across execution starts; individual values remain per execution."},
    {"id":"git.ending_dirty_files","category":"repository","unit":"count","aggregation":"maximum","collection":"ros-derived","description":"Maximum dirty-path count observed across execution finalizations; individual values remain per execution."},
    {"id":"git.commits_created","category":"repository","unit":"count","aggregation":"sum","collection":"ros-derived","description":"Commits reachable from the ending commit but not the starting commit."},
    {"id":"git.files_added","category":"repository","unit":"count","aggregation":"sum","collection":"ros-derived","description":"Files added during a clean-baseline execution."},
    {"id":"git.files_modified","category":"repository","unit":"count","aggregation":"sum","collection":"ros-derived","description":"Files modified during a clean-baseline execution."},
    {"id":"git.files_deleted","category":"repository","unit":"count","aggregation":"sum","collection":"ros-derived","description":"Files deleted during a clean-baseline execution."},
    {"id":"git.files_renamed","category":"repository","unit":"count","aggregation":"sum","collection":"ros-derived","description":"Files renamed during a clean-baseline execution."},
    {"id":"git.binary_files_changed","category":"repository","unit":"count","aggregation":"sum","collection":"ros-derived","description":"Binary files changed during a clean-baseline execution."},
    {"id":"git.lines_added","category":"repository","unit":"lines","aggregation":"sum","collection":"ros-derived","description":"Lines added during a clean-baseline execution."},
    {"id":"git.lines_deleted","category":"repository","unit":"lines","aggregation":"sum","collection":"ros-derived","description":"Lines deleted during a clean-baseline execution."},
    {"id":"tests.added","category":"development-quality","unit":"count","aggregation":"sum","collection":"ros-derived","description":"Test files added during a clean-baseline execution."},
    {"id":"tests.modified","category":"development-quality","unit":"count","aggregation":"sum","collection":"ros-derived","description":"Test files modified during a clean-baseline execution."},
    {"id":"tests.removed","category":"development-quality","unit":"count","aggregation":"sum","collection":"ros-derived","description":"Test files removed during a clean-baseline execution."},
    {"id":"tests.count_before","category":"development-quality","unit":"count","aggregation":"none","collection":"external-tool","description":"Test count before work when deterministically reported by a test tool."},
    {"id":"tests.count_after","category":"development-quality","unit":"count","aggregation":"none","collection":"external-tool","description":"Test count after work when deterministically reported by a test tool."},
    {"id":"tests.executions","category":"development-quality","unit":"count","aggregation":"sum","collection":"runtime-or-agent","description":"Test-suite executions."},
    {"id":"tests.passed","category":"development-quality","unit":"count","aggregation":"sum","collection":"external-tool","description":"Passing test results reported across test executions; repeated runs are counted again and are not unique test cases."},
    {"id":"tests.failed","category":"development-quality","unit":"count","aggregation":"sum","collection":"external-tool","description":"Tests failed."},
    {"id":"tests.skipped","category":"development-quality","unit":"count","aggregation":"sum","collection":"external-tool","description":"Tests skipped."},
    {"id":"build.executions","category":"development-quality","unit":"count","aggregation":"sum","collection":"runtime-or-agent","description":"Build executions."},
    {"id":"build.failures","category":"development-quality","unit":"count","aggregation":"sum","collection":"external-tool","description":"Build failures."},
    {"id":"compiler.errors","category":"development-quality","unit":"count","aggregation":"sum","collection":"external-tool","description":"Compiler-detected errors."},
    {"id":"lint.errors","category":"development-quality","unit":"count","aggregation":"sum","collection":"external-tool","description":"Lint errors."},
    {"id":"lint.warnings","category":"development-quality","unit":"count","aggregation":"sum","collection":"external-tool","description":"Lint warnings."},
    {"id":"static_analysis.errors","category":"development-quality","unit":"count","aggregation":"sum","collection":"external-tool","description":"Static-analysis errors."},
    {"id":"architecture_check.failures","category":"development-quality","unit":"count","aggregation":"sum","collection":"external-tool","description":"Architecture-check failures."},
    {"id":"requirements.affected","category":"traceability","unit":"count","aggregation":"sum","collection":"agent-or-work-system","description":"Requirements affected."},
    {"id":"requirements.satisfied","category":"traceability","unit":"count","aggregation":"sum","collection":"agent-or-work-system","description":"Requirements satisfied."},
    {"id":"acceptance_criteria.affected","category":"traceability","unit":"count","aggregation":"sum","collection":"agent-or-work-system","description":"Acceptance criteria affected."},
    {"id":"acceptance_criteria.satisfied","category":"traceability","unit":"count","aggregation":"sum","collection":"agent-or-work-system","description":"Acceptance criteria satisfied."},
    {"id":"defects.discovered","category":"development-quality","unit":"count","aggregation":"sum","collection":"agent-or-tool","description":"Defects discovered."},
    {"id":"defects.corrected","category":"development-quality","unit":"count","aggregation":"sum","collection":"agent-or-tool","description":"Defects corrected."},
    {"id":"regressions.found","category":"development-quality","unit":"count","aggregation":"sum","collection":"agent-or-tool","description":"Regressions found."},
    {"id":"work.new_items","category":"scope-discovery","unit":"count","aggregation":"sum","collection":"agent-or-work-system","description":"New work generated by discoveries."},
    {"id":"blockers.discovered","category":"scope-discovery","unit":"count","aggregation":"sum","collection":"agent","description":"Blockers discovered."},
    {"id":"dependencies.discovered","category":"scope-discovery","unit":"count","aggregation":"sum","collection":"agent","description":"Unexpected dependencies discovered."},
    {"id":"architecture.findings","category":"scope-discovery","unit":"count","aggregation":"sum","collection":"agent","description":"Material architecture findings recorded."},
    {"id":"documentation.files_changed","category":"repository","unit":"count","aggregation":"sum","collection":"ros-derived","description":"Documentation files changed during a clean-baseline execution."},
    {"id":"quality.false_leads","category":"development-quality","unit":"count","aggregation":"sum","collection":"agent","description":"False leads explicitly recorded."},
    {"id":"quality.disproven_hypotheses","category":"development-quality","unit":"count","aggregation":"sum","collection":"agent-or-research","description":"Hypotheses disproven with evidence."},
    {"id":"quality.silent_omissions","category":"development-quality","unit":"count","aggregation":"sum","collection":"human-or-agent","description":"Silent omissions later detected."},
    {"id":"quality.invalid_transitions_prevented","category":"development-quality","unit":"count","aggregation":"sum","collection":"ros-derived","description":"Invalid ROS state transitions mechanically prevented."},
    {"id":"telemetry.redactions","category":"telemetry-quality","unit":"count","aggregation":"sum","collection":"ros-derived","description":"Sensitive raw fields redacted during ingestion."},
    {"id":"telemetry.unknown_fields","category":"telemetry-quality","unit":"count","aggregation":"sum","collection":"ros-derived","description":"Provider fields preserved without a normalized mapping."},
    {"id":"telemetry.raw_snapshots_omitted","category":"telemetry-quality","unit":"count","aggregation":"sum","collection":"ros-derived","description":"Raw provider snapshots omitted by repository retention policy while normalized metrics and field discovery were retained."},
    {"id":"runtime.memory_peak_bytes","category":"runtime-performance","unit":"bytes","aggregation":"maximum","collection":"runtime","description":"Peak runtime memory observed."},
    {"id":"runtime.cpu_utilization","category":"runtime-performance","unit":"ratio","aggregation":"maximum","collection":"runtime","description":"Runtime CPU utilization from zero through one."}
  ]
}
