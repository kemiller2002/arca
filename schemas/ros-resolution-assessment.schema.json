{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/schemas/ros-resolution-assessment.schema.json",
  "title": "Praxis Resolution Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "assessmentId",
    "resolutionId",
    "semantic",
    "operational",
    "assessor",
    "assessedAt",
    "recordedAt",
    "evidenceReferences",
    "method",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "ros.resolution-assessment"
    },
    "schemaVersion": {
      "const": 1
    },
    "assessmentId": {
      "type": "string",
      "minLength": 1
    },
    "resolutionId": {
      "type": "string",
      "minLength": 1
    },
    "semantic": {
      "enum": [
        "confirmed",
        "incorrect",
        "unresolved",
        "not-assessable"
      ]
    },
    "operational": {
      "enum": [
        "succeeded",
        "neutral",
        "refused-or-dead-end",
        "harmful-or-failed",
        "outcome-unknown",
        "not-assessable"
      ]
    },
    "assessedAt": {
      "type": "string",
      "format": "date-time"
    },
    "evidenceReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assessor": {
      "type": "string",
      "minLength": 1
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
