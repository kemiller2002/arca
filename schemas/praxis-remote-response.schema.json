{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kemiller2002/praxis/schemas/praxis-remote-response.schema.json",
  "title": "Praxis remote response (praxis.remote 1.x)",
  "description": "The structured outcome of a praxis.remote request. outcome=unknown is never promoted to success or failure; failure.decidedBy separates Praxis decisions from executor/transport failures; replayed=true means a recorded outcome was returned without executing again.",
  "type": "object",
  "required": [
    "protocol",
    "protocolVersion",
    "requestId",
    "operation",
    "outcome",
    "replayed",
    "repository",
    "praxisVersion",
    "failure",
    "result",
    "persistence"
  ],
  "properties": {
    "protocol": {
      "const": "praxis.remote"
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "requestId": {
      "type": [
        "string",
        "null"
      ]
    },
    "operation": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "enum": [
        "succeeded",
        "rejected",
        "failed",
        "unknown"
      ]
    },
    "replayed": {
      "type": "boolean"
    },
    "repository": {
      "type": "object",
      "required": [
        "ref",
        "expectedSha",
        "observedSha"
      ],
      "properties": {
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "expectedSha": {
          "type": [
            "string",
            "null"
          ]
        },
        "observedSha": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "praxisVersion": {
      "type": "string",
      "minLength": 1
    },
    "executor": {
      "type": "object",
      "description": "Observed executor facts (DF-ROS-2026-A041 section 7).",
      "required": [
        "kind",
        "praxisVersion",
        "assurance"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "runId": {
          "type": [
            "string",
            "null"
          ]
        },
        "runAttempt": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflowRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "host": {
          "type": [
            "string",
            "null"
          ]
        },
        "principal": {
          "type": [
            "string",
            "null"
          ]
        },
        "praxisVersion": {
          "type": "string"
        },
        "assurance": {
          "const": "observed-by-executor"
        }
      },
      "additionalProperties": false
    },
    "failure": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "code",
            "decidedBy",
            "retry",
            "message",
            "problems"
          ],
          "properties": {
            "code": {
              "enum": [
                "invalid-request",
                "secret-detected",
                "unsupported-protocol",
                "unsupported-operation",
                "unauthorized",
                "idempotency-conflict",
                "stale-ref",
                "domain-rejected",
                "validation-failed",
                "concurrency-conflict",
                "bootstrap-failed",
                "repository-write-failed",
                "transport-failed",
                "rate-limited",
                "timeout",
                "cancelled",
                "internal"
              ]
            },
            "decidedBy": {
              "enum": [
                "praxis",
                "executor"
              ]
            },
            "retry": {
              "enum": [
                "never",
                "same-request",
                "after-refresh"
              ]
            },
            "message": {
              "type": "string"
            },
            "problems": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "field",
                  "message"
                ],
                "properties": {
                  "field": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "result": {
      "description": "The executing command's own machine-readable output, verbatim, or null."
    },
    "persistence": {
      "type": "object",
      "description": "Praxis-owned paths this request changed and the adapter may persist (including its journal entry). Empty for reads, rejections and failures.",
      "required": [
        "paths"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\.ros/"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "failure": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "rejected",
              "failed",
              "unknown"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "failure": {
            "type": "object"
          }
        }
      }
    }
  ]
}
