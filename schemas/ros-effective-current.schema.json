{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/schemas/ros-effective-current.schema.json",
  "title": "Praxis Effective Current Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "basisCount",
    "supersededResolutionIds",
    "resolution",
    "assessment"
  ],
  "properties": {
    "schema": {
      "const": "ros.effective-current"
    },
    "schemaVersion": {
      "const": 1
    },
    "basisCount": {
      "type": "integer",
      "minimum": 0
    },
    "supersededResolutionIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolution": {
      "type": [
        "object",
        "null"
      ]
    },
    "assessment": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
