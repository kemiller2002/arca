<Project>
  <PropertyGroup>
    <!-- The release version of both packages (EchelonFoundry.Arca.Core and
         EchelonFoundry.Arca.GitHub). 0.0.0 means "not released yet": the
         release workflow builds, tests and packs it but never publishes it. -->
    <Version>0.2.1</Version>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <WarningLevel>5</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 1182: unused variables; 25: incomplete matches are errors. -->
    <OtherFlags>$(OtherFlags) --warnon:1182 --warnaserror:25</OtherFlags>
    <Deterministic>true</Deterministic>
    <!-- EchelonFoundry.Aegis.Integration.GitHub needs FSharp.Core >= 10.1.400,
         so FSharp.Core is pinned centrally (Directory.Packages.props) instead
         of the SDK's implicit reference. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <Authors>Echelon Foundry</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/kemiller2002/arca</RepositoryUrl>
    <PackageProjectUrl>https://github.com/kemiller2002/arca</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.fsproj'">
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
